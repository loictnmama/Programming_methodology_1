#include <iostream>
#include <string>
using namespace std;


int main()
{
    
    //4-digit numbers

    int digits;

    cout << "Enter a 4 digits : ";
    cin >> digits;
    cout << endl;


    // invalid digits

    if (digits > 9999)
    {

        cout << "Invalid number!\n";

}
    else
        if (digits <= 0000)
        {

            cout << "Invalid number!\n";

        }
        else
        {
            //sum of the digits

            int a, b, c, d, sumDigits;

            a = digits / 1000;
            b = (digits / 100) % 10;
            c = (digits / 10) % 10;
            d = digits % 10;

            sumDigits = a + b + c + d;

            cout << "The sum of digits is : " << sumDigits << endl;


        }

    return 0;



}


