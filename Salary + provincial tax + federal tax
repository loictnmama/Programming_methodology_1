#include <iostream>
#include <string>
using namespace std;

int main()
{
	// Variables
	double salary, salaryTax, pTax, fTax, totTax;

	// Annual salary

	cout << "Enter annual salary $ : ";
	cin >> salary;

	// Provincial tax

	if (salary <= 53255)
	{

		pTax = salary * 0.14;
	}
	else
		if (salary <= 106495)
		{
			pTax = salary * 0.19;
		}
		else
			if (salary <= 129590)
			{
				pTax = salary * 0.24;
			}
			else

			{

				pTax = salary * 0.2575;

			}

	// Federal tax

	if (salary <= 57375)
	{

		fTax = salary * 0.145;

	}
	else
		if (salary <= 114750)
		{

			fTax = salary * 0.205;

		}
		else
			if (salary <= 177882)
			{

				fTax = salary * 0.26;

			}
			else
				if (salary <= 253414)
				{

					fTax = salary * 0.29;

				}
				else
				{

					fTax = salary * 0.33;

				}

	// Salary after tax

	totTax = pTax + fTax;
	salaryTax = salary - totTax;

	// Briefing

	cout << "Provincial tax : " << pTax << endl;
	cout << "Federal tax : " << fTax << endl;
	cout << "Total tax : " << totTax << endl;
	cout << "Salary after tax : " << salaryTax << endl;

	return 0;



}
